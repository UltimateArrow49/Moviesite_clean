@app.get("/ext/tmdb/details/<media>/<int:item_id>")
def tmdb_details(media, item_id):
    return _tmdb_get(f"/{media}/{item_id}")

@app.get("/ext/tmdb/season/<int:show_id>/<int:season>")
def tmdb_season(show_id, season):
    return _tmdb_get(f"/tv/{show_id}/season/{season}")

@app.get("/ext/tmdb/episode/<int:show_id>/<int:season>/<int:episode>")
def tmdb_episode(show_id, season, episode):
    return _tmdb_get(f"/tv/{show_id}/season/{season}/episode/{episode}")
