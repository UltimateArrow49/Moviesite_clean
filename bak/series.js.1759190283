const grid = document.getElementById("grid");
const searchBar = document.getElementById("searchBar");
const modal = document.getElementById("playerModal");
const closeBtn = document.getElementById("closeModal");
const frame = document.getElementById("vkFrame");
const nowPlaying = document.getElementById("nowPlaying");

const IMG = "https://image.tmdb.org/t/p/w500";
let page = 1, q = "", loading = false, done = false;

function card(t) {
  const div = document.createElement("div");
  div.className = "card";
  const poster = t.poster_path ? IMG + t.poster_path : "/thumbs/placeholder.png";
  div.innerHTML = `
    <img class="thumb" src="${poster}" alt="">
    <div class="meta">
      <p class="title">${t.name}</p>
      <p class="sub">⭐ ${(t.vote_average||0).toFixed(1)} · ${(t.first_air_date||"").slice(0,4)}</p>
    </div>`;
  div.addEventListener("click", () => {
    const url = `/player.html?src=${encodeURIComponent(t.name)}`;
    frame.src = url;
    nowPlaying.textContent = t.name || "";
    modal.classList.remove("hidden");
  });
  return div;
}

async function fetchPage() {
  if (loading || done) return;
  loading = true;
  const base = q ? "/ext/tmdb/search" : "/ext/tmdb/trending";
  const params = new URLSearchParams({ media: "tv", page: page.toString() });
  if (q) params.set("query", q);
  const r = await fetch(`${base}?${params}`, { cache: "no-store" });
  if (!r.ok) { loading = false; return; }
  const data = await r.json();
  const results = data.results || [];
  if (results.length === 0) done = true;
  results.forEach(x => grid.appendChild(card(x)));
  page += 1;
  loading = false;
}

function resetAndLoad(newQ) {
  q = (newQ||"").trim();
  page = 1; done = false; grid.innerHTML = "";
  fetchPage();
}

function onScroll() {
  if (loading||done) return;
  const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 800;
  if (nearBottom) fetchPage();
}

closeBtn.addEventListener("click", () => { frame.src = ""; modal.classList.add("hidden"); });
let deb;
searchBar.addEventListener("input", () => { clearTimeout(deb); deb=setTimeout(() => resetAndLoad(searchBar.value), 300); });

window.addEventListener("scroll", onScroll);
document.addEventListener("DOMContentLoaded", () => resetAndLoad(""));
