<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"/><title>Series</title><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <link rel="stylesheet" href="/style.css?v=1"/>
</head>
<body data-page="series">
  <header class="topbar">
    <div style="display:flex;gap:8px;align-items:center">
      <a href="/" class="btn" style="text-decoration:none;padding:8px 12px;border:1px solid #2a3a4a;border-radius:8px;color:#9bb4cc">Home</a>
      <h1 style="margin:0 0 0 12px">Series</h1>
    </div>
    <div class="right"><input id="search" placeholder="Search series…"/></div>
  </header>
  <main><div id="grid" class="grid"></div></main>

  <script type="module">
  import { tmdbTrending, tmdbSearch, TMDB_IMG } from "/providers/tmdb.js";
  const grid = document.getElementById("grid");
  const search = document.getElementById("search");

  function card(x){
    const year = (x.first_air_date||"").slice(0,4);
    const href = `/player.html?vk=tv&tmdb=${encodeURIComponent(x.id)}&season=1&episode=1&title=${encodeURIComponent(x.name||"")}&autoPlay=true&nextEpisode=true&episodeSelector=true&color=3ba0ff`;
    return `
      <a class="card" href="${href}">
        <img class="thumb" src="${TMDB_IMG(x.poster_path)}" alt="">
        <div class="meta">
          <p class="title">${x.name||""} ${year?`(${year})`:""}</p>
          <p class="sub">Online</p>
        </div>
      </a>`;
  }

  async function load(){
    const data = await tmdbTrending("tv", 1);
    grid.innerHTML = (data.results||[]).map(card).join("") || "<p>No results.</p>";
  }
  search.addEventListener("input", async () => {
    const q = search.value.trim();
    if (!q) return load();
    const data = await tmdbSearch(q, "tv", 1);
    grid.innerHTML = (data.results||[]).map(card).join("") || "<p>No results.</p>";
  });
  load();
  </script>
</body></html>
