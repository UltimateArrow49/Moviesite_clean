import urllib.request, urllib.parse
import json
from flask import Flask, request, jsonify, send_from_directory, Response
from pathlib import Path
import os, json, urllib.parse, urllib.request

app = Flask(__name__, static_folder="/movie_site_clean", static_url_path="")

# ---------- health ----------
@app.get("/healthz")
def healthz():
    return "ok"

# ---------- local media ----------
@app.get("/api/media")
def api_media():
    p = Path("/movie_site_clean/index.json")
    if p.exists():
        return Response(p.read_text(), mimetype="application/json")
    return jsonify({"items": []})

# ---------- TMDB helpers ----------
TMDB_BASE = "https://api.themoviedb.org/3"

def tmdb_headers():
    return {
        "Authorization": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJiN2QxY2M4NTU0ZmNhYjQxZTAxMzQyOGUyZGM0MThkZSIsIm5iZiI6MTc1ODQ5NjE2Ny4yMDMsInN1YiI6IjY4ZDA4NWE3YzliZWYzMjYmQ0MTIiMCI... (rest of your token) ..."
    }
def http_get_json(url, params=None, headers=None, timeout=10):
    if params:
        url = f"{url}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        data = r.read().decode("utf-8")
        return Response(data, status=r.getcode(), mimetype="application/json")

# /ext/tmdb/trending?media=movie|tv&page=1
@app.get("/ext/tmdb/trending")
def tmdb_trending():
    media = request.args.get("media", "movie")
    page = int(request.args.get("page", "1") or "1")
    url = f"{TMDB_BASE}/trending/{media}/day"
    return http_get_json(url, {"page": page}, tmdb_headers())

# /ext/tmdb/search?q=Term&media=movie|tv&page=1
@app.get("/ext/tmdb/search")
def tmdb_search():
    q = request.args.get("q", "")
    media = request.args.get("media", "movie")
    page = int(request.args.get("page", "1") or "1")
    path = "search/movie" if media == "movie" else "search/tv"
    url = f"{TMDB_BASE}/{path}"
    params = {"query": q, "page": page, "include_adult": "false", "language": "en-US"}
    return http_get_json(url, params, tmdb_headers())

# ---------- root & static ----------
@app.get("/")
def root_index():
    return send_from_directory(app.static_folder, "index.html")

# Flask’s static handler will serve /movies.html, /series.html, /player.html,
# /style.css, /app.js, /providers/*.js, /thumbs/*, etc.

# Gunicorn entrypoint: app_main:app

@app.route("/")
def _root_index():
    return send_from_directory("/movie_site_clean", "index.html")

@app.route("/<path:filename>")
def _static_files(filename):
    return send_from_directory("/movie_site_clean", filename)

@app.route("/healthz")
def _healthz():
    return "ok", 200

# --- TMDB HELPER START ---

BASE_V3 = "https://api.themoviedb.org/3"

def tmdb_headers():
    return {
        "Authorization": "Bearer PASTE_FULL_READ_TOKEN_HERE",
        "Accept": "application/json",
        "Content-Type": "application/json;charset=utf-8",
    }

def http_get_json_with_fallback(url_path, query):
    # Try bearer token first (v4-style auth to v3 endpoints works)
    url = f"{BASE_V3}{url_path}"
    q1 = urllib.parse.urlencode(query)
    req = urllib.request.Request(url + ("?" + q1 if q1 else ""), headers=tmdb_headers())
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        # Fallback: use v3 api_key in query if auth failed
        if e.code in (401, 403):
            q2 = dict(query); q2["api_key"] = "b7d1cc8554fcab41e013428e2dc418de"
            q2s = urllib.parse.urlencode(q2)
            with urllib.request.urlopen(url + ("?" + q2s if q2s else ""), timeout=20) as r:
                return json.loads(r.read().decode("utf-8"))
        raise

# --- TMDB HELPER END ---
