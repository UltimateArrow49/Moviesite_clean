import boto3
import os
from flask import jsonify, url_for, redirect, redirect
from flask import jsonify, url_for, redirect, Flask, send_from_directory, jsonify, Response, make_response
import os, mimetypes, time, re, subprocess, shutil, hashlib

BASE_DIR  = os.path.dirname(__file__)
MEDIA_DIR = os.path.join(BASE_DIR, "media")
THUMB_DIR = os.path.join(BASE_DIR, "thumbs")
os.makedirs(MEDIA_DIR, exist_ok=True); os.makedirs(THUMB_DIR, exist_ok=True)

FFMPEG = shutil.which("ffmpeg"); ENABLE_THUMBS = bool(FFMPEG)
ALLOWED_EXT = {".mp4",".webm",".mov",".m4v",".mkv",".avi",".wmv",".mpg",".mpeg",".m2ts",".ts",".flv"}
IMG_EXTS = (".png",".jpg",".jpeg")

app = Flask(__name__)

@app.get("/__ping")
def _ping(): return "pong", 200

@app.get("/__routes")
def _routes(): return ("\n".join(sorted(str(r.rule) for r in app.url_map.iter_rules()))+"\n", 200, {"Content-Type":"text/plain"}

@app.get("/")
def root(): return send_from_directory(BASE_DIR, "index.html")
@app.get("/style.css")
def css():  return send_from_directory(BASE_DIR, "style.css")
@app.get("/app.js")
def js():   return send_from_directory(BASE_DIR, "app.js")
@app.get("/favicon.ico")
def fav():  return ("",204)

def pretty_title(fn:str)->str:
    name = os.path.splitext(fn)[0]
    name = re.sub(r"[._]+"," ",name).strip()
    return " ".join(w.capitalize() for w in name.split()) or fn

_cache = {"files":[], "etag":None, "ts":0.0}
def scan_media():
    out=[]
    for n in os.listdir(MEDIA_DIR):
        p = os.path.join(MEDIA_DIR,n)
        if not os.path.isfile(p): continue
        ext = os.path.splitext(n)[1].lower()
        if ext in ALLOWED_EXT or (mimetypes.guess_type(n)[0] or "").startswith("video/"):
            st = os.stat(p)
            out.append({"id":n,"name":n,"title":pretty_title(n),"size":st.st_size,"modified":int(st.st_mtime*1000)})
    out.sort(key=lambda x:x["title"].lower())
    total = sum(f["size"] for f in out)
    newest = max((f["modified"] for f in out), default=0)
    etag = hashlib.sha1(f"{len(out)}:{total}:{newest}".encode()).hexdigest()
    return out, etag

def get_index(force=False):
    now=time.time()
    if not force and now-_cache["ts"]<10 and _cache["files"]: return _cache["files"], _cache["etag"]
    files, etag = scan_media(); _cache.update({"files":files,"etag":etag,"ts":now}); return files, etag

@app.get("/api/media")
def api_media():
    files, etag = get_index(False)
    resp = make_response(jsonify({"files":files,"total":len(files)}))
    resp.headers["ETag"]=etag; resp.headers["Cache-Control"]="no-store"; return resp

@app.route("/video/<path:filename>")
def video(filename): return send_from_directory(MEDIA_DIR, filename)

def _norm(s:str)->str: return re.sub(r"[^0-9a-z]+","", s.lower())

@app.get("/poster/<path:filename>")
def poster(filename):
    base = os.path.splitext(filename)[0]
    want = _norm(base)

    for ext in IMG_EXTS:
        p = os.path.join(THUMB_DIR, base + ext)
        if os.path.exists(p): return send_from_directory(THUMB_DIR, os.path.basename(p))

    best=None; score=0
    for fn in os.listdir(THUMB_DIR):
        lf=fn.lower()
        if not lf.endswith(IMG_EXTS): continue
        nb=_norm(os.path.splitext(fn)[0])
        sc = 3 if nb==want else (2 if (want in nb or nb in want) else (1 if (nb.startswith(want) or want.startswith(nb)) else 0))
        if sc>score: score,best=sc,fn
    if best: return send_from_directory(THUMB_DIR, best)

    if ENABLE_THUMBS:
        guess = os.path.join(MEDIA_DIR, base)
        for ext in ALLOWED_EXT:
            v = guess if guess.lower().endswith(ext) else guess + ext
            if os.path.exists(v):
                out = os.path.join(THUMB_DIR, _norm(base)+".jpg"); tmp = out + ".tmp"
                try:
                    subprocess.run([FFMPEG,"-y","-ss","1","-i",v,"-frames:v","1","-vf","scale=320:-1",tmp],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
                    os.replace(tmp,out)
                    return send_from_directory(THUMB_DIR, os.path.basename(out))
                except Exception: break

    title = pretty_title(filename)
    svg = f"<svg xmlns='http://www.w3.org/2000/svg' width='320' height='180'><rect width='100%' height='100%' fill='#0e141b'/><text x='50%' y='52%' dominant-baseline='middle' text-anchor='middle' fill='#8b98a5' font-size='18'>{title}</text></svg>"
    return Response(svg, mimetype="image/svg+xml")

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=False)

# --- moviesite: redirect /media/<key> to Backblaze B2 ---
try:
    app
except NameError:
    from flask import jsonify, url_for, redirect, Flask
    app = Flask(__name__)

from urllib.parse import quote

@app.route("/media/<path:key>")
def media_redirect(key):
    import os
    base = os.environ.get(
        "MEDIA_BASE_URL",
        "https://f003.backblazeb2.com/file/moviesite-media-henry"
    ).rstrip("/")
    return redirect(f"{base}/{quote(key, safe='/')}", code=302)
# --- end moviesite patch ---

# --- moviesite: list movies from Backblaze (S3 API) ---
@app.route("/api/movies")
def api_movies():
    bucket = os.environ.get("B2_BUCKET", "moviesite-media-henry")
    endpoint = os.environ.get("B2_S3_ENDPOINT", "https://s3.eu-central-003.backblazeb2.com")
    s3 = boto3.client(
        "s3",
        endpoint_url=endpoint,
        aws_access_key_id=os.environ.get("AWS_ACCESS_KEY_ID"),
        aws_secret_access_key=os.environ.get("AWS_SECRET_ACCESS_KEY"),
        region_name="eu-central-003",
    )
    items = []
    paginator = s3.get_paginator("list_objects_v2")
    for page in paginator.paginate(Bucket=bucket):
        for obj in page.get("Contents", []):
            key = obj["Key"]
            kl = key.lower()
            if not (kl.endswith(".mp4") or kl.endswith(".mkv") or kl.endswith(".webm")):
                continue
            size = int(obj.get("Size", 0))
            items.append({
                "key": key,
                "name": key.split("/")[-1],
                "size": size,
                "url": url_for("media_redirect", key=key, _external=False)
            })
    items.sort(key=lambda x: x["name"].lower())
    return jsonify(items)
# --- end ---

# --- Show poster endpoint: /poster/series/<show> ---
import os
from flask import send_from_directory, Response

try:
    THUMB_DIR
except NameError:
    BASE_DIR = os.path.dirname(__file__)
    THUMB_DIR = os.path.join(BASE_DIR, "thumbs")

IMG_EXTS = (".png",".jpg",".jpeg")

def _variants(name:str):
    b = os.path.splitext(os.path.basename(name))[0]
    cand = {
        b, b.lower(),
        b.replace(".", " "), b.replace(".", "_"),
        b.replace("_", " "), b.replace(" ", "_"),
        b.replace(" ", "."), b.replace("-", " ").replace("-", "_")
    }
    return [c for c in cand if c]

@app.get("/poster/series/<path:show>")
def poster_series(show):
    for base in _variants(show):
        for ext in IMG_EXTS:
            p = os.path.join(THUMB_DIR, "series", base + ext)
            if os.path.isfile(p):
                return send_from_directory(os.path.dirname(p), os.path.basename(p))
    title = " ".join(show.replace("_"," ").replace("."," ").split())
    svg = f"""<svg xmlns=http://www.w3.org/2000/svg viewBox=0
