:root{
  --bg:#0b1117; --card:#121a22; --ink:#dbe6ff; --muted:#8aa0b5; --ring:#375a7f; --accent:#3ba0ff;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.4 system-ui,Segoe UI,Roboto,Ubuntu,sans-serif}

.topbar{
  position:sticky;top:0;z-index:5;background:linear-gradient(180deg,#0b1117,#0b111700);
  display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid #111923;
}
.topbar h1{margin:0;font-size:20px}
.topbar .right{display:flex;gap:10px;align-items:center}
.topbar input{
  background:#0e1620;border:1px solid #1c2a37;color:var(--ink);padding:8px 10px;border-radius:8px;min-width:200px;outline:none;
}
.topbar button{
  background:var(--accent);color:#001428;border:0;padding:8px 12px;border-radius:8px;cursor:pointer;font-weight:600;
}

main{padding:18px}

/* === Uniform grid === */
.grid{
  display:grid;
  gap:16px;
  grid-template-columns: repeat(auto-fill, 180px); /* fixed width tiles */
  justify-content:center;
}
.card{
  background:var(--card);
  border:1px solid #131f2a;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 6px 18px rgba(0,0,0,.25);
  transition:transform .12s ease, box-shadow .12s ease;
  cursor:pointer;
  width:180px;
  height:270px; /* fixed height */
  display:flex;
  flex-direction:column;
}
.card:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(0,0,0,.35)}
.card img.thumb, .card img.poster{
  width:100%;
  height:70%;
  object-fit:cover;
  background:#0e141b;
}
.meta{padding:8px;flex:1;display:flex;flex-direction:column;justify-content:center;text-align:center}
.title{font-size:14px;font-weight:600;margin:0 0 4px 0;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sub{font-size:12px;color:var(--muted);margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* === Modal === */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:grid;place-items:center}
.modal.hidden{display:none}
.modal-card{background:var(--card);border:1px solid #1b2834;border-radius:16px;max-width:min(1100px,92vw);width:100%;padding:14px;position:relative}
.modal-card video{width:100%;max-height:70vh;background:black;border-radius:10px}
.close{position:absolute;top:10px;right:10px;background:#0f1720;border:1px solid #253446;color:#9fb6cc;border-radius:8px;padding:6px 8px;cursor:pointer}
.np{margin-top:8px;color:var(--muted)}

/* === Progress bar === */
.card-progress{
  width:100%;height:4px;background:#1b2430;
  border-radius:999px;overflow:hidden;margin-top:4px;
}
.card-progress>.fill{height:100%;width:0%;background:#ff2d2d;transition:width .12s linear}

/* --- UI polish additions --- */
.toolbar { margin: 12px 0 16px; display: flex; gap: 8px; }
.btn { padding: 8px 14px; border-radius: 9999px; border: 1px solid #0b8bd1; background:#0ea5e9; color:#fff; cursor:pointer; box-shadow: 0 2px 6px rgba(0,0,0,.25); }
.btn:hover { filter: brightness(1.05); }
.btn:disabled { opacity:.6; cursor:not-allowed; }
.btn.btn-secondary { background: transparent; color:#9bb4cc; border-color:#2a3a4a; }

/* --- Series page controls --- */
.toolbar{display:flex;gap:.75rem;align-items:center;margin:10px 12px 6px 12px}
.btn{display:inline-block;padding:.45rem .7rem;border:1px solid #3a4a5a;border-radius:10px;background:#0e151e;color:#9cc4ff;text-decoration:none}
.btn:hover{background:#101b28}
.tabs{display:flex;gap:.5rem;flex-wrap:wrap}
.tab{padding:.35rem .7rem;border:1px solid #3a4a5a;border-radius:9999px;background:#0e151e;color:#a9c0d8;cursor:pointer}
.tab.active{background:#1e2a39;color:#fff;border-color:#5a7aa0}

/* --- Series dropdown --- */
.select{padding:.45rem .7rem;border:1px solid #3a4a5a;border-radius:10px;background:#0e151e;color:#cfe3ff}
.dd .label{color:#9bb4cc;margin-right:.35rem}

/* ===== Series toolbar (sub-header) ===== */
.series-toolbar{
  display:flex; justify-content:space-between; align-items:center;
  gap:.75rem; margin:10px 12px 6px; padding:6px 8px;
}
.series-toolbar .left, .series-toolbar .right{display:flex; gap:.6rem; align-items:center}
.series-toolbar .label{color:#a9c0d8; opacity:.9;}

/* Back button matches site style */
.btn.back{padding:.45rem .7rem;border:1px solid #3a4a5a;border-radius:10px;background:#0e151e;color:#9cc4ff;text-decoration:none}
.btn.back:hover{background:#101b28}

/* Titles: 2-line clamp + tooltip works */
.card .meta .title{
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
  overflow:hidden; line-height:1.1; min-height:2.3em;
}

/* Make poster <img> a bit taller on series page for consistency */
.card .thumb{object-fit:cover; height:170px; width:100%; border-radius:10px 10px 0 0}

/* Simple link-style nav (used by Movies/Series text links) */
.navlink{color:#9cc4ff;text-decoration:underline;font-weight:600;border:0;background:transparent;padding:0;cursor:pointer}
.navlink:hover{color:#cfe2ff;text-decoration:underline}

/* card titles: clamp to two lines with ellipsis (no awkward cuts) */
.card .title{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  line-height:1.25;
  max-height:2.55em;
  word-break:break-word;
}

/* Card title wrap (no cut-off) */
.card .title,.media-card .title{
  white-space:normal; overflow:hidden;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
  line-height:1.25; min-height:2.5em;
}

/* unified nav & titles */
.navbtn{display:inline-block;padding:.35rem .7rem;border:1px solid #3a4a5a;border-radius:10px;background:#0e151e;color:#a9c0d8;text-decoration:none}
.navbtn:hover{background:#101b28}
.navbtn.active{background:#1e2a39;color:#fff;border-color:#5a7aa0}

/* movie/episode card titles: clamp to 2 lines */
.card-title{
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
  min-height:2.6em; /* keeps rows even */
}

/* season / back controls row */
.toolbar{display:flex;gap:.6rem;align-items:center;margin:6px 0}
@media (min-width:768px){ .toolbar{margin-left:auto} } /* float right on wide screens */

/* nav-series-link */
header a[href="series.html"]{
  border:0 !important;
  background:none !important;
  padding:0 !important;
  margin-left:12px !important;
  text-decoration:underline !important;
  color:#9cc4ff !important;
  border-radius:0 !important;
}

/* card title: wrap to 2 lines cleanly */
.card .title{
  white-space:normal;
  overflow:hidden;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
}

/* === Captions under posters (shared Movies/Series) === */
.card, .tile, .grid a.item, .grid a.card, .grid a.tile { position: relative; overflow: hidden; }
.card .cap, .tile .cap, .grid a.item .cap, .grid a.card .cap, .grid a.tile .cap{
  position:absolute; left:0; right:0; bottom:0;
  padding:10px 12px;
  background: linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,0));
  color:#cfe3ff; font-weight:600; line-height:1.2;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  pointer-events:none;
  border-bottom-left-radius:18px; border-bottom-right-radius:18px;
}

/* a little extra bottom space so the caption does not crowd the rim */
.card img, .tile img, .grid a.item img, .grid a.card img, .grid a.tile img{ display:block }

/* === Nav pills (make Series on home look like Movies pill on series page) === */
.pill{
  display:inline-block; padding:.36rem .70rem;
  border:1px solid #3a4a5a; border-radius:12px;
  background:#0e151e; color:#b8d9ff !important; text-decoration:none;
}
.pill:hover{ background:#101b28; text-decoration:none; }

/* === Captions under posters (Movies/Series) === */
.card, .tile, .grid a.item, .grid a.card, .grid a.tile { position: relative; overflow: hidden; }
.card .cap, .tile .cap, .grid a.item .cap, .grid a.card .cap, .grid a.tile .cap{
  position:absolute; left:0; right:0; bottom:0;
  padding:10px 12px;
  background: linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,0));
  color:#cfe3ff; font-weight:600; line-height:1.2;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  pointer-events:none;
  border-bottom-left-radius:18px; border-bottom-right-radius:18px;
}

/* === Shared nav pill button === */
.pill{
  display:inline-block; padding:.36rem .70rem;
  border:1px solid #3a4a5a; border-radius:12px;
  background:#0e151e; color:#b8d9ff !important; text-decoration:none;
}
.pill:hover{ background:#101b28; text-decoration:none; }

/* --- Series toolbar & captions (safe append) --- */
.toolbar{display:flex;gap:.75rem;align-items:center;margin:10px 12px 14px 12px}
.pill{display:inline-block;padding:.36rem .70rem;border:1px solid #3a4a5a;border-radius:12px;background:#0e151e;color:#b8d9ff!important;text-decoration:none}
.pill:hover{background:#101b28}
.card,.tile,.grid a.item,.grid a.card,.grid a.tile{position:relative;overflow:hidden}
.card .cap,.tile .cap,.grid a.item .cap,.grid a.card .cap,.grid a.tile .cap{
  position:absolute;left:0;right:0;bottom:0;padding:10px 12px;
  background:linear-gradient(to top,rgba(0,0,0,.78),rgba(0,0,0,0));
  color:#cfe3ff;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  pointer-events:none;border-bottom-left-radius:18px;border-bottom-right-radius:18px
}

/* ---- injected: titles/pills/grid ---- */
.grid{
  display:grid; gap:22px; padding:14px;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
}
.card{position:relative; overflow:hidden; border-radius:18px; background:#0f151c; box-shadow:0 0 0 1px rgba(255,255,255,.06) inset}
.card img{width:100%; height:260px; object-fit:cover; display:block}
.cap{
  position:absolute; left:0; right:0; bottom:0;
  padding:10px 12px;
  background:linear-gradient(to top,rgba(3,10,18,.92),rgba(3,10,18,.0));
  color:#d7e9ff; font-weight:600; line-height:1.22;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  pointer-events:none;
}
.toolbar{display:flex; gap:.75rem; align-items:center; padding:10px 12px 6px}
.pill{display:inline-block; padding:.36rem .70rem; border:1px solid #3a4a5a;
  border-radius:12px; background:#0e151e; color:#b8d9ff!important; text-decoration:none}
.pill:hover{background:#101b28}
.hide{display:none!important}

/* --- UI toolbelt --- */
:root{--card-rad:18px}
.toolbar{position:sticky;top:0;z-index:5;display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;padding:10px 12px;background:linear-gradient(180deg,rgba(13,18,25,.95),rgba(13,18,25,.85) 60%,rgba(13,18,25,0))}
.pill{display:inline-block;padding:.36rem .70rem;border:1px solid #3a4a5a;border-radius:12px;background:#0e151e;color:#b8d9ff!important;text-decoration:none}
.pill:hover{background:#101b28}
.pill.active{background:#14212e;box-shadow:0 0 0 1px #2e3c4c inset}
.select{background:#0e151e;border:1px solid #3a4a5a;color:#cfe3ff;padding:.34rem .5rem;border-radius:10px}

/* --- Cards & grid (shared Movies/Series/Episodes) --- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:18px;padding:14px 12px 48px}
.card{position:relative;overflow:hidden;border-radius:var(--card-rad);background:#13202c;box-shadow:0 0 0 1px rgba(255,255,255,.06) inset}
.card img{width:100%;height:100%;display:block;object-fit:cover;aspect-ratio:2/3}
.cap{position:absolute;left:0;right:0;bottom:0;padding:10px 12px;background:linear-gradient(to top,rgba(0,0,0,.82),rgba(0,0,0,0));color:#cfe3ff;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}

/* --- Mobile tweaks --- */
@media(max-width:600px){
  .grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px}
  .pill-label{display:none}
}
/* safety: if two toolbars render, hide the second */
.toolbar + .toolbar{display:none}
