:root{
  --bg:#0b1117; --card:#121a22; --ink:#dbe6ff; --muted:#8aa0b5; --ring:#3ba0ff; --accent:#3ba0ff;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,Segoe UI,Roboto,Ubuntu,Arial,sans-serif}

/* Nav */
.nav{position:sticky;top:0;z-index:10;display:flex;gap:.75rem;align-items:center;padding:.75rem 1rem;background:#0d141c; border-bottom:1px solid #1b2632}
.nav .brand{font-weight:700;text-decoration:none;color:var(--ink)}
.nav .links{display:flex;gap:.5rem}
.btn{padding:.45rem .8rem;border:1px solid #223445;border-radius:999px;color:var(--ink);text-decoration:none;transition:all .15s ease;background:#101925}
.btn:hover{border-color:var(--ring);box-shadow:0 0 0 3px #3ba0ff22}
.btn.active{background:linear-gradient(180deg,#133,#0f1b28);border-color:#2b4d6f}
.spacer{flex:1}
.search{width:240px;max-width:50vw;background:#0f1823;border:1px solid #223445;border-radius:10px;color:var(--ink);padding:.45rem .6rem;outline:none}
.search:focus{border-color:var(--ring);box-shadow:0 0 0 3px #3ba0ff22}

/* Layout */
.wrap{max-width:1200px;margin:1rem auto;padding:0 1rem}
.toolbar{display:flex;align-items:center;gap:1rem;margin:.5rem 0 1rem}
.toolbar h1{font-size:1.35rem;margin:0}

/* Cards Grid */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:.9rem}
.card{display:flex;flex-direction:column;background:var(--card);border:1px solid #1f2b39;border-radius:14px;overflow:hidden;text-decoration:none;color:var(--ink);transition:transform .12s ease, box-shadow .12s ease, border-color .12s}
.card:hover{transform:translateY(-2px);border-color:#2d4156;box-shadow:0 10px 28px #00000055}
.card .thumb{aspect-ratio:2/3;background:#0e1620;display:flex;align-items:center;justify-content:center;overflow:hidden}
.card .thumb img{width:100%;height:100%;object-fit:cover;display:block}
.card .title{padding:.6rem .7rem;font-weight:600;min-height:3.1em}

/* Simple responsive */
@media (max-width:700px){
  .grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
}
