import os
from flask import Flask, request, Response
import urllib.parse, urllib.request

app = Flask(__name__)

TMDB_READ_BEAR = "eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJiN2QxY2M4NTU0ZmNhYjQxZTAxMzQyOGUyZGM0MThkZSIsIm5iZiI6MTc1ODQ5NjE2Ny4yMDMsInN1YiI6IjY4ZDA4NWE3YzliZWIyZmZjYmQ0MTliMCIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.Q2gi3xRWiPq8_2zICdbvvQ3hT0GQf6zQUGtRrBYXvcU"

def _tmdb_get(path, params=None):
    url = f"https://api.themoviedb.org/3{path}"
    if params:
        qs = urllib.parse.urlencode(params)
        url += "?" + qs
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {TMDB_READ_BEAR}",
        "Accept": "application/json"
    })
    with urllib.request.urlopen(req, timeout=15) as r:
        data = r.read()
        return Response(data, status=r.getcode(), mimetype="application/json")

@app.get("/ext/tmdb/trending")
def tmdb_trending():
    media = request.args.get("media", "movie")
    page = request.args.get("page", "1")
    return _tmdb_get(f"/trending/{media}/week", {"page": page})

@app.get("/ext/tmdb/search")
def tmdb_search():
    media = request.args.get("media", "movie")
    query = request.args.get("query", "")
    page = request.args.get("page", "1")
    return _tmdb_get(f"/search/{media}", {"query": query, "page": page, "include_adult": "false"})

    token = os.environ.get("TMDB_API_TOKEN")
    if not token:
        return Response(
            json.dumps({"error": "TMDB_API_TOKEN not set"}),
            status=500,
            mimetype="application/json"
        )

    url = f"https://api.themoviedb.org/3/{rest}"
    try:
        r = requests.get(url, headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json"
        })
        if r.status_code != 200:
            app.logger.error("TMDB error %s: %s", r.status_code, r.text[:200])
        return Response(r.text, status=r.status_code, mimetype="application/json")
    except Exception as e:
        app.logger.exception("TMDB proxy failed")
        return Response(
            json.dumps({"error": str(e)}),
            status=500,
            mimetype="application/json"
        )

