# --- TMDB proxy with safe error handling ---
import json, requests, os
from flask import Response

@app.get("/api/tmdb/<path:rest>")
def api_tmdb(rest):
    token = os.environ.get("TMDB_API_TOKEN")
    if not token:
        return Response(
            json.dumps({"error": "TMDB_API_TOKEN not set"}),
            status=500,
            mimetype="application/json"
        )
    url = f"https://api.themoviedb.org/3/{rest}"
    try:
        r = requests.get(url, headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json"
        })
        if r.status_code != 200:
            app.logger.error("TMDB error %s: %s", r.status_code, r.text[:200])
        return Response(r.text, status=r.status_code, mimetype="application/json")
    except Exception as e:
        app.logger.exception("TMDB proxy failed")
        return Response(
            json.dumps({"error": str(e)}),
            status=500,
            mimetype="application/json"
        )
