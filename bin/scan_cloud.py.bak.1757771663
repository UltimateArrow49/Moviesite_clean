#!/usr/bin/env python3
import base64, json, os, re, sys, urllib.request, urllib.parse

ENV = "/etc/moviesite/b2.env"
env = {}
if os.path.exists(ENV):
    for line in open(ENV, "r", encoding="utf-8"):
        line=line.strip()
        if not line or line.startswith("#") or "=" not in line: continue
        k,v=line.split("=",1); env[k.strip()]=v.strip()

KEY_ID      = env.get("B2_KEY_ID","")
APP_KEY     = env.get("B2_APP_KEY","")
BUCKET_ID   = env.get("B2_BUCKET_ID","")
BUCKET_NAME = env.get("B2_BUCKET_NAME","")

VIDEO_EXTS = (".mp4",".mkv",".mov",".avi",".ts",".m2ts",".webm",".flv")

OUT_DIR      = "/movie_site_clean/manifests"
OUT_SERIES   = os.path.join(OUT_DIR, "series")
os.makedirs(OUT_SERIES, exist_ok=True)

def http_json(url, payload=None, headers=None, timeout=45):
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers or {}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))

def authorize():
    auth = base64.b64encode(f"{KEY_ID}:{APP_KEY}".encode()).decode()
    url  = "https://api.backblazeb2.com/b2api/v2/b2_authorize_account"
    req  = urllib.request.Request(url, headers={"Authorization": f"Basic {auth}"})
    with urllib.request.urlopen(req, timeout=45) as r:
        return json.loads(r.read().decode())

def list_all_files(api_url, token, bucket_id):
    url = f"{api_url}/b2api/v2/b2_list_file_names"
    items = []
    start = ""
    while True:
        payload = {"bucketId": bucket_id, "maxFileCount": 1000}
        if start: payload["startFileName"] = start
        res = http_json(url, payload, headers={"Authorization": token})
        items.extend(res.get("files", []))
        start = res.get("nextFileName")
        if not start: break
    return items

def titleize(name:str)->str:
    base = os.path.splitext(os.path.basename(name))[0]
    base = re.sub(r"[._]+", " ", base)
    return re.sub(r"\s+", " ", base).strip()

def slugify(text:str)->str:
    s = re.sub(r"[^0-9a-zA-Z]+", "-", text).strip("-")
    return s.lower() or "show"

def parse_season(season_name:str)->int:
    # Season folder like "Season 1", "S02", "Series 3"
    m = re.search(r"(?:s(?:eason)?|series)\s*(\d+)", season_name, re.I)
    if m: return int(m.group(1))
    # fallback: first number in folder
    m = re.search(r"(\d+)", season_name)
    return int(m.group(1)) if m else 1

def parse_episode_num(filename:str)->int:
    # Try SxxEyy
    m = re.search(r"[sS](\d+)[eE](\d+)", filename)
    if m: return int(m.group(2))
    # Try Ep/Episode 12
    m = re.search(r"(?:ep(?:isode)?)[ _-]*(\d+)", filename, re.I)
    if m: return int(m.group(1))
    # Try leading number like "01 - Title"
    m = re.search(r"(^|\D)(\d{1,3})(\D|$)", filename)
    if m: return int(m.group(2))
    return 999999  # push unknowns to the end but keep stable order

def main():
    if not (KEY_ID and APP_KEY and BUCKET_ID and BUCKET_NAME):
        print("Missing B2 creds in /etc/moviesite/b2.env", file=sys.stderr)
        sys.exit(1)

    auth = authorize()
    api_url     = auth["apiUrl"]
    downloadUrl = auth["downloadUrl"]
    token       = auth["authorizationToken"]
    base        = f"{downloadUrl}/file/{BUCKET_NAME}/"

    files = list_all_files(api_url, token, BUCKET_ID)

    movies = []
    shows  = {}  # show -> { slug, seasons: { season_num: {name, number, episodes: []} } }

    for f in files:
        key  = f.get("fileName","")
        size = f.get("contentLength", 0)
        lower = key.lower()
        if not lower.endswith(VIDEO_EXTS):  # only videos
            continue

        if lower.startswith("series/"):
            # Expect series/<Show>/<Season>/<EpisodeFile>
            parts = key.split("/")
            # Ensure we have at least show + file
            if len(parts) < 3:
                # If missing season folder, infer season=1, episode from file
                show_name = parts[1] if len(parts) > 1 else "Series"
                season_name = "Season 1"
                ep_file = parts[-1]
            else:
                show_name   = parts[1]
                # If 3 parts: series/Show/Episode, infer season=1
                if len(parts) == 3:
                    season_name = "Season 1"
                    ep_file = parts[2]
                else:
                    season_name = parts[2]
                    ep_file = parts[-1]

            show_title = titleize(show_name)
            season_num = parse_season(season_name)
            ep_title   = titleize(ep_file)
            ep_num     = parse_episode_num(ep_file)

            s = shows.setdefault(show_title, {"slug": slugify(show_title), "seasons": {}})
            ss = s["seasons"].setdefault(season_num, {"name": f"Season {season_num}", "number": season_num, "episodes": []})
            ss["episodes"].append({
                "file": key[len("series/"):],  # relative under series/
                "title": ep_title,
                "epNumber": ep_num,
                "size": size
            })
        else:
            movies.append({
                "file": key,
                "title": titleize(key),
                "size": size
            })

    # Sort movies and series structures
    movies.sort(key=lambda x: x["title"].lower())

    # Build series index and per-show manifests
    series_index = {"baseUrl": base+"series/", "items": []}
    for show_title, data in sorted(shows.items(), key=lambda kv: kv[0].lower()):
        seasons = []
        for snum, ss in sorted(data["seasons"].items(), key=lambda kv: kv[0]):
            ss["episodes"].sort(key=lambda e: (e["epNumber"], e["title"].lower()))
            seasons.append({"name": ss["name"], "number": ss["number"], "count": len(ss["episodes"])})
        series_index["items"].append({
            "show": show_title,
            "slug": data["slug"],
            "seasons": [s["number"] for s in seasons],
            "seasonCount": len(seasons),
            "totalEpisodes": sum(s["count"] for s in seasons)
        })

        # write per-show manifest
        show_manifest = {
            "baseUrl": base+"series/",
            "show": show_title,
            "slug": data["slug"],
            "seasons": []
        }
        for snum, ss in sorted(data["seasons"].items(), key=lambda kv: kv[0]):
            show_manifest["seasons"].append({
                "name": ss["name"],
                "number": ss["number"],
                "episodes": ss["episodes"]  # already sorted by epNumber
            })
        with open(os.path.join(OUT_SERIES, f"{data[slug]}.json"), "w", encoding="utf-8") as fh:
            json.dump(show_manifest, fh, indent=2)

    # Write movies + series index
    with open(os.path.join(OUT_DIR, "movies.json"), "w", encoding="utf-8") as fh:
        json.dump({"baseUrl": base, "items": movies}, fh, indent=2)

    with open(os.path.join(OUT_DIR, "series.json"), "w", encoding="utf-8") as fh:
        json.dump(series_index, fh, indent=2)

    print(f"Wrote {len(movies)} movies, {len(series_index[items])} shows, and {len(os.listdir(OUT_SERIES))} per-show manifests.")
